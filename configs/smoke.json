{
  "seed": 42,
  "output_dir": "outputs",
  "data": {
    "datasets": [
      "nsl_kdd"
    ],
    "root": "data",
    "max_rows_per_dataset": 3000,
    "temporal_split": {
      "train": 0.7,
      "val": 0.15,
      "test": 0.15
    },
    "normalize": "standard",
    "n_jobs": 4
  },
  "model": {
    "input_dim": null,
    "hidden_dim": 128,
    "latent_dim": 64,
    "num_layers": 2,
    "dropout": 0.2
  },
  "training": {
    "batch_size": 256,
    "epochs": 1,
    "lr": 0.0005,
    "weight_decay": 0.0001,
    "kl_weight": 0.05,
    "agil_weight": 0.5,
    "grad_clip": 5.0,
    "early_stopping_patience": 5
  },
  "agil": {
    "epsilon": 0.03,
    "steps": 3,
    "step_size": 0.01
  },
  "ablation": {
    "run": true,
    "variants": [
      "full"
    ]
  },
  "evaluation": {
    "thresholds": [
      0.5
    ],
    "run_obfuscation": true,
    "obfuscation": {
      "idp": [
        0.1,
        0.2,
        0.3
      ],
      "ibp": [
        0.1,
        0.3,
        0.5
      ],
      "apr": [
        0.5
      ],
      "inp": [
        0.5
      ]
    },
    "few_shot_shots": [
      1,
      3,
      5,
      10
    ]
  }
}